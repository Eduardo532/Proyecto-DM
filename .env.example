# Copia este archivo como .env (en la raíz del proyecto) para cambiar la configuración de Docker.

# Puerto de la aplicación en tu equipo: http://localhost:8000
VDM_PORT=8000

# Modelo de narración (ver docs/guia-ollama.md). Con 4 GB de VRAM: qwen3.5:2b. Con 16 GB de RAM o más
# puedes probar qwen3.5:4b (más lento, mejor narración).
VDM_LLM_MODEL=qwen3.5:2b
VDM_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Tokens de contexto por llamada. Súbelo si tienes más memoria de vídeo.
VDM_LLM_CONTEXT_BUDGET=5000
