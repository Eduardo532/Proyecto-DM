# Copia este archivo como backend/.env y ajusta lo que necesites.
# Todas las variables son opcionales.

# Carpeta de datos (base de datos, PDF, mapas, copias). Por defecto: <repositorio>/data
# VDM_DATA_DIR=C:/Users/tu-usuario/VirtualDM/data

# Aplicar migraciones al arrancar (true/false)
# VDM_AUTO_MIGRATE=true
